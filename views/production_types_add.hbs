<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="mobile-viewport">
    <div class="content-area">
      <div class="add-container">
        <h3>{{title}}</h3>

        <div class="media-preview-box">
          <img src="http://localhost:9000/production-types-media/{{draft.image_key}}" alt="Превью производства">

          <label class="file-picker">
            <span class="file-picker-label">ВЫБРАТЬ ИЗОБРАЖЕНИЕ</span>
            <input type="file" accept="image/*" class="file-picker-input">
          </label>

          <video src="http://localhost:9000/production-types-media/{{draft.video_key}}" controls></video>

          <label class="file-picker">
            <span class="file-picker-label">ВЫБРАТЬ ВИДЕО</span>
            <input type="file" accept="video/*" class="file-picker-input">
          </label>
        </div>

        <form>
          <div class="form-group">
            <label>Тип производства</label>
            <input type="text" value="{{draft.craft_title}}">
          </div>
          <div class="form-group">
            <label>Описание</label>
            <textarea rows="4">{{draft.description}}</textarea>
          </div>
          <div class="form-group">
            <label>Норма выхода продукции (шт)</label>
            <input type="number" value="{{draft.production_output_rate}}">
          </div>
          <div class="form-group">
            <label>Количество отходов/брака (кг)</label>
            <input type="number" value="{{draft.defect_waste_quantity}}">
          </div>
        </form>
      </div>
    </div>
    {{> production_types_tabbar}}
  </div>
</body>
</html>