<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="mobile-viewport">
    <div class="content-area feed-screen">
      <video class="feed-video" autoplay loop muted playsinline>
        <source src="http://localhost:9000/types-of-productions-media/{{item.video_key}}" type="video/mp4">
      </video>

      <div class="feed-overlay">
        <div>
          <h2 style="font-size: 16px; margin-bottom: 2px;">{{item.craft_title}}</h2>
          <p style="font-size: 11px; opacity: 0.85;">Датировка: {{item.dating_century}} в. н.э.</p>
        </div>
        <div class="feed-actions">
          <div class="feed-like-clean">
            <span style="font-size: 22px; line-height: 1;">❤</span>
            <span>{{likes_count}}</span>
          </div>
        </div>
        <div class="feed-bottom">
          <div class="feed-info">
            <p>Норма выхода: <strong>{{item.production_output_rate}} шт/смена</strong></p>
            <p>Брак и отходы: <strong>{{item.defect_waste_quantity}} кг</strong></p>
            <p>Длительность цикла: <strong>{{item.technological_cycle_hours}} ч</strong></p>
          </div>

          <div class="feed-next-btn">
            <a href="/types_of_productions/feed/{{item.production_id}}?next=true" class="feed-btn">Следующий ➔</a>
          </div>
        </div>
      </div>
    </div>
    {{> types_of_productions_tabbar}}
  </div>
</body>
</html>