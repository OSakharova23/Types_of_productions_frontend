<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="mobile-viewport">
    <div class="content-area">
      <form action="/types_of_productions" method="GET" class="filter-form">
        <input 
          type="number" 
          name="production_output_rate" 
          placeholder="Мин. норма выхода (шт)..." 
          value="{{search_rate}}"
        >
        <button type="submit">Найти</button>
      </form>

      <div class="tile-grid">
        {{#each productions}}
        <a href="/types_of_productions/feed/{{this.production_id}}" class="card">
          <img src="http://localhost:9000/types-of-productions-media/{{this.image_key}}" alt="{{this.craft_title}}" class="card-image">
          <div class="card-info">
            <p class="card-title">{{this.craft_title}}</p>
            <p>Норма: {{this.production_output_rate}} шт</p>
            <p style="color: #1A1A1A; font-size: 10px;">
                <span style="color: #d62542;">❤</span> {{this.likes_count}}
            </p>
          </div>
        </a>
        {{/each}}
      </div>
    </div>
    {{> types_of_productions_tabbar}}
  </div>
</body>
</html>